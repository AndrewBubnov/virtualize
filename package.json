{
  "name": "clear-virtualizer",
  "version": "0.1.0",
  "description": "A lightweight React hook for virtualized lists and tables with dynamic row heights, measured automatically",
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "author": {
    "name": "Andrew Bubnov"
  },
  "license": "MIT",
  "homepage": "https://github.com/AndrewBubnov/virtualize#readme",
  "bugs": {
    "url": "https://github.com/AndrewBubnov/virtualize/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewBubnov/virtualize.git"
  },
  "keywords": [
    "react",
    "virtualized",
    "virtualization",
    "virtual-list",
    "react-virtualized",
    "react-window",
    "windowing",
    "infinite-scroll",
    "large-lists",
    "performance",
    "scroll",
    "dom-virtualization",
    "resize-observer",
    "dynamic-heights",
    "layout-engine",
    "ui-performance",
    "frontend",
    "react-components",
    "list-rendering",
    "overscan",
    "table"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "vite build --config src/vite.config.ts && tsc --emitDeclarationOnly -p tsconfig.lib.json",
    "prepublishOnly": "npm run build:lib",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node src/__tests__/e2e/repro-scroll.mjs"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "jsdom": "^30.0.1",
    "lorem-ipsum": "^2.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vite-plugin-eslint": "^1.8.1",
    "vite-tsconfig-paths": "^4.2.0",
    "vitest": "^1.6.1"
  }
}
