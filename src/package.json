{
  "name": "clear-virtualizer",
  "version": "0.0.1",
  "description": "A lightweight, performant component for virtualization in React",
  "author": "Andrew Bubnov",
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly"
  },
  "keywords": [
    "react",
    "virtualized",
    "virtualization",
    "virtual-list",
    "react-virtualized",
    "react-window",
    "windowing",
    "infinite-scroll",
    "large-lists",
    "performance",
    "scroll",
    "dom-virtualization",
    "resize-observer",
    "dynamic-heights",
    "layout-engine",
    "ui-performance",
    "frontend",
    "react-components",
    "list-rendering",
    "overscan"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AndrewBubnov/virtualize"
  },
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
